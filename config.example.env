# keenetic-dev local configuration (not committed — see .gitignore)
# Router access (Keenetic Ultra / Netcraze, Entware, SSH on 222)
ROUTER_HOST=192.168.165.1
ROUTER_PORT=222
ROUTER_USER=root
ROUTER_PASS=lip368lip

# Web panel of the deployed app
APP_NAME=keenetic-smb-ui
APP_PANEL_USER=admin
APP_PANEL_PASS=1235467890
APP_PORT=8099

# SMB address served by the app (native NDMS SMB keeps the other addresses)
SMB_IP=192.168.160.2

# Paths on the router
APP_BIN=/opt/bin/keenetic-smb-ui
APP_INIT=/opt/etc/init.d/S99keenetic-smb-ui
APP_CFG_DIR=/opt/etc/keenetic-smb-ui
APP_LOG_DIR=/opt/var/keenetic-smb-ui/log

# Go toolchain as seen from WSL (Windows Go cross-compiles to linux/*)
GO_BIN=/mnt/c/workspace/tools/go/bin/go.exe
